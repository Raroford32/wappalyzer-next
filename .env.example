# Leave WAPPALYZER_WORKERS unset for resource-aware top-level sizing.
# WAPPALYZER_WORKERS=4

# Leave WAPPALYZER_ASSET_WORKERS unset to share the CPU budget across HTTP workers.
# WAPPALYZER_ASSET_WORKERS=1

WAPPALYZER_ASSET_LIMIT=64
WAPPALYZER_MAX_ASSET_BYTES=2097152
WAPPALYZER_CONNECT_TIMEOUT=5
WAPPALYZER_READ_TIMEOUT=30
WAPPALYZER_MAX_RESPONSE_BYTES=10485760
WAPPALYZER_VERIFY_TLS=1

# Optional speed/coverage trade-off. Keep empty for complete full scans.
# WAPPALYZER_BLOCK_RESOURCE_TYPES=image,font,media

# Docker Compose writes bind-mounted reports as the invoking host user.
WAPPALYZER_UID=10001
WAPPALYZER_GID=10001
